{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    { "source": "/galeria/:path*", "destination": "/#espacio", "statusCode": 301 },
    { "source": "/nosotros/:path*", "destination": "/#concepto", "statusCode": 301 },
    { "source": "/servicios/:path*", "destination": "/#eventos", "statusCode": 301 },
    { "source": "/condiciones-de-uso/:path*", "destination": "/legal.html#condiciones", "statusCode": 301 },
    { "source": "/carta/:path*", "destination": "/#carta", "statusCode": 301 },
    { "source": "/menu/:path*", "destination": "/#carta", "statusCode": 301 },
    { "source": "/contacto/:path*", "destination": "/#visitanos", "statusCode": 301 },
    { "source": "/reservas/:path*", "destination": "/", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpeg|jpg|png|svg|mp4|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
